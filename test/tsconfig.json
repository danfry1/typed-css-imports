{ "compilerOptions": { "target": "esnext", "module": "esnext", "moduleResolution": "bundler", "strict": true, "noEmit": true, "allowArbitraryExtensions": true },
  "include": ["."],
  "contentMappers": [{ "package": "typed-css-imports", "extensions": [".module.css", ".module.scss", ".module.sass"],
    "options": { "localsConvention": "camelCase", "sass": { "loadPaths": ["styles"] } } }] }
