// Type-checks the package's own JavaScript sources (src/) with JSDoc inference. Tests have their own tsconfig in test/.
{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    // postcss-selector-parser's own declarations fail TypeScript 7's circularity check (TS5115).
    "skipLibCheck": true
  },
  "include": ["src"]
}
