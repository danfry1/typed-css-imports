// Builds the package: src/*.ts -> dist/ (JavaScript plus declarations for the `./transform` export).
// Tests have their own tsconfig in test/.
{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "types": ["node"],
    // postcss-selector-parser's own declarations fail TypeScript 7's circularity check (TS5115).
    "skipLibCheck": true
  },
  "include": ["src"]
}
