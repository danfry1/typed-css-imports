{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    // vite/client declares `*.module.css` as { [key: string]: string }; the content mapper's types take precedence.
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"],
  "contentMappers": [
    { "package": "typed-css-imports", "extensions": [".module.css"], "options": { "localsConvention": "camelCase" } }
  ]
}
