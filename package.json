{
  "name": "typed-css-imports",
  "version": "0.1.0",
  "description": "Typed CSS and Sass module imports with plain tsc: `styles.buttn` is a compile error. A TypeScript 7.1 content mapper.",
  "license": "MIT",
  "author": "Daniel Fry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danfry1/typed-css-imports.git"
  },
  "homepage": "https://github.com/danfry1/typed-css-imports#readme",
  "bugs": "https://github.com/danfry1/typed-css-imports/issues",
  "keywords": [
    "typescript",
    "css-modules",
    "sass",
    "content-mapper",
    "tsc",
    "types"
  ],
  "type": "module",
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    "./mapper": "./src/server.js",
    "./transform": "./src/transform.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "typed-css-imports": "src/cli.js"
  },
  "files": [
    "src",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/server.js"
      ]
    }
  },
  "scripts": {
    "test": "pnpm typecheck && tsc -p test --runExternalCode && node --test \"test/*.test.mjs\" && test/fallback.sh && pnpm --filter example-vite-react run typecheck && pnpm --filter example-vite-react run parity",
    "typecheck": "tsc -p .",
    "test:package": "test/package.sh",
    "prepublishOnly": "node -e \"if (!process.env.GITHUB_ACTIONS) { console.error('Releases are published from CI: push a signed v* tag (see Releasing in README.md).'); process.exit(1) }\""
  },
  "dependencies": {
    "postcss": "8.5.30",
    "postcss-modules": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "npm": "11.21.1",
    "sass": "1.105.1",
    "typed-css-imports": "link:",
    "typescript": "7.1.0-dev.20261015.1"
  }
}
